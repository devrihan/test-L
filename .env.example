# ─── Keycloak (public — used in browser and server) ───────────────────────────
# URL where your local Keycloak instance is running
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180

# The Keycloak realm configured for this app
NEXT_PUBLIC_KEYCLOAK_REALM=inferentics-realm

# The Keycloak client ID registered under the realm above
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=react-app

# ─── Keycloak Admin (server-side only — never exposed to the browser) ─────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── API URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8082
NEXT_PUBLIC_AGGREGATED_DATA_API_URL=http://localhost:8082
NEXT_PUBLIC_BEAVER_API_URL=http://localhost:4000


# Contentsquare / Hotjar unified tag — token from the "Get started > Tag installation" screen
NEXT_PUBLIC_HOTJAR_ID=b40********142a
# ─── Runtime config (config-manager; server-side only, never NEXT_PUBLIC_) ────
# Base URL of the config-manager service (directory-services droplet)
CONFIG_MANAGER_URL=http://localhost:3007
# Bearer token loam presents when fetching config
CONFIG_MANAGER_TOKEN=CHANGE_ME
# Bearer token config-manager presents when pushing a refresh to loam
CONFIG_REFRESH_TOKEN=CHANGE_ME
# Interim stub mode (until config-manager is deployed): config is read from the
# committed config-stub.json at the repo root — no service needed. Prod flag
# changes = edit that file, merge, auto-deploy. Remove both vars at cutover.
CONFIG_STUB_ENABLED=true
CONFIG_DEV_SCHOOL=school_a   # school override until the token carries a school claim

# ─── user-registry (server-side only — never NEXT_PUBLIC_) ────────────────────
# Base URL of the user-registry service; /api/auth/password forwards the
# change-password call there. No fallback — the route 500s if unset.
USER_REGISTRY_URL=http://localhost:3008
